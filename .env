# ==========================================
# Eye-LLM: Spatial Intent Prediction System
# 环境变量配置
# ==========================================

# ------------------------------------------
# 阿里云 Qwen API配置（推荐）
# ------------------------------------------
# 获取 API Key: https://bailian.console.aliyun.com/
# 格式: sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QWEN_API_KEY=“sk-a90cd639de534608ab97c911022de5c1”

# Qwen API 基础URL
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型配置
LLM_MODEL=qwen-plus
VLM_MODEL=qwen-vl-max-latest
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# ------------------------------------------
# OpenAI API配置（可选）
# ------------------------------------------
# OPENAI_API_KEY=your_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------
# SAM 2配置（Replicate API）
# ------------------------------------------
# 获取API Token: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_token_here
SAM2_MODEL_VERSION=lucataco/segment-anything-2

# ------------------------------------------
# 记忆配置
# ------------------------------------------
SHORT_TERM_SIZE=5
LONG_TERM_MAX_SIZE=10000

# ------------------------------------------
# 注意力等级配置（单位：秒）
# ------------------------------------------
ATTENTION_A=120
ATTENTION_B=60
ATTENTION_C=30
ATTENTION_D=15
ATTENTION_E=5

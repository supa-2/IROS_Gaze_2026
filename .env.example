SHORT_TERM_SIZE=5
LONG_TERM_MAX_SIZE=10000

# ------------------------------------------
# 注意力等级配置（单位：秒）
# ------------------------------------------
# A: 深度关注 - 长时间仔细观看
ATTENTION_A=120
# B: 中等关注 - 正常观看
ATTENTION_B=60
# C: 一般关注 - 浏览式观看
ATTENTION_C=30
# D: 快速浏览 - 短暂停留
ATTENTION_D=15
# E: 一瞥而过 - 快速扫视
ATTENTION_E=5


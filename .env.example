REPLICATE_API_TOKEN=r8_OeqoF6RNCfM94oc2BzDO1KEAegiu9oD0MGY9N
SAM2_MODEL_VERSION=meta/sam2-hiera-large
# 可选: meta/sam2-hiera-base 或 meta/sam2-hiera-small

# ------------------------------------------
# 记忆配置
